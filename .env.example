# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_STRONG=claude-sonnet-4-6

# --- Prospect sourcing ---
APIFY_API_TOKEN=

# --- Email verification (default: ZeroBounce) ---
ZEROBOUNCE_API_KEY=

# --- Sequencer (default: Smartlead; Instantly stubbed) ---
SMARTLEAD_API_KEY=
INSTANTLY_API_KEY=

# --- Database (SQLite for v1, Postgres-portable schema) ---
DATABASE_URL=sqlite:///./signal_outreach.db

# --- Pipeline defaults ---
DEFAULT_GEO=Portland, OR
DEFAULT_VERTICAL=HVAC
PAIN_SCORE_THRESHOLD=55

# --- Compliance / sending caps ---
DAILY_CAP_PER_INBOX=30
SPAM_RATE_PAUSE_THRESHOLD=0.001
BOUNCE_RATE_PAUSE_THRESHOLD=0.03

# CAN-SPAM footer requirements -- fill before Phase 6 (sequencer push). No sending happens before then.
FOOTER_MAILING_ADDRESS=<<FILL: your physical mailing address>>
SENDING_DOMAINS=<<FILL: comma-separated dedicated sending domains, warmed and ready>>
