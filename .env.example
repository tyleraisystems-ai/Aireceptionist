# Retell AI — also used to verify X-Retell-Signature on inbound webhooks
RETELL_API_KEY=

# Database
DATABASE_URL=postgresql+psycopg://aireceptionist:aireceptionist@localhost:5432/aireceptionist

# Google Calendar (M2) — create a service account, share the target
# calendar with its email (Editor access), then either:
#   - set this to a filesystem path to the service account JSON key, or
#   - paste the JSON key contents directly (must start with "{")
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=

# Jobber CRM (M4)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REFRESH_TOKEN=

# Twilio SMS (M4)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# App
ENVIRONMENT=development

# Retell agent provisioning (M3) — used by scripts/provision_retell_agent.py
# Public base URL where Retell can reach this backend's Custom Function
# endpoints (an ngrok URL while testing, your real domain once deployed).
BACKEND_BASE_URL=http://localhost:8000
# Voice id to assign the agent. Find one via `retell.voice.list()` or the
# Retell dashboard's Voice Library — there is no sensible placeholder default.
RETELL_VOICE_ID=
